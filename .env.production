APP_IMAGE=ghcr.io/your-github-username/daily-report-app:latest
# Set these values in your production platform or secret manager.
DATABASE_URL=postgresql://user:password@host:5432/daily_reports
AUTH_SECRET=generate-a-strong-secret
NEXTAUTH_SECRET=generate-a-strong-secret
AUTH_URL=https://dailyreports.example.com
NEXTAUTH_URL=https://dailyreports.example.com
AUTH_SESSION_MAX_AGE=604800
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
UPLOAD_PROVIDER=s3
UPLOAD_DIR=./public/uploads
AWS_REGION=us-east-1
S3_UPLOAD_BUCKET=daily-report-app-production
S3_UPLOAD_PREFIX=production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dailyreports.app
CRON_SECRET=replace-with-a-cron-secret
PRODUCTION_ADMIN_EMAIL=admin@example.com
PRODUCTION_ADMIN_PASSWORD=ChangeMe1234
APP_SSM_PARAMETER_PATH=/daily-report-app/production
