generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  email                String         @unique
  passwordHash         String         @map("password_hash")
  passwordResetToken   String?        @unique @map("password_reset_token")
  passwordResetExpires DateTime?      @map("password_reset_expires")
  role                 Role           @default(USER)
  avatarUrl            String?        @map("avatar_url")
  theme                Theme          @default(SYSTEM)
  reminderEnabled      Boolean        @default(true) @map("reminder_enabled")
  reminderTime         String         @default("17:00") @map("reminder_time")
  isActive             Boolean        @default(true) @map("is_active")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  activityLogs         ActivityLog[]
  announcements        Announcement[]
  configUpdates        AppConfig[]    @relation("AppConfigUpdatedBy")
  taskHistory          TaskHistory[]
  tasks                Task[]

  @@map("users")
}

model Task {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  date              DateTime
  ticketNumber      String        @map("ticket_number")
  ticketTitle       String        @map("ticket_title")
  ticketDescription String        @map("ticket_description")
  storyPoint        Float?        @map("story_point")
  dailyReport       String        @map("daily_report")
  status            TaskStatus    @default(TODO)
  flagged           Boolean       @default(false)
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  attachments       Attachment[]
  history           TaskHistory[]
  tags              TaskTag[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([date])
  @@index([ticketNumber])
  @@index([ticketTitle])
  @@index([status])
  @@index([flagged])
  @@map("tasks")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now()) @map("created_at")
  tasks     TaskTag[]

  @@index([name])
  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  fileType  String   @map("file_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model TaskHistory {
  id        String            @id @default(uuid()) @db.Uuid
  taskId    String            @map("task_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  action    TaskHistoryAction
  changes   Json
  createdAt DateTime          @default(now()) @map("created_at")
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  targetId   String?  @map("target_id")
  targetType String?  @map("target_type")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  title     String
  message   String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")
  admin     User      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model AppConfig {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("AppConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("app_config")
}

enum Role {
  ADMIN
  USER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskHistoryAction {
  CREATED
  UPDATED
  DELETED
}
