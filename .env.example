APP_IMAGE=ghcr.io/your-github-username/daily-report-app:latest
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_reports
# NextAuth v5 uses AUTH_SECRET; keep NEXTAUTH_SECRET for compatibility
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SESSION_MAX_AGE=604800
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
UPLOAD_PROVIDER=local
UPLOAD_DIR=./public/uploads
AWS_REGION=us-east-1
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=daily-report-app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASS=your-password
SMTP_FROM=noreply@dailyreports.app
CRON_SECRET=replace-with-a-cron-secret
APP_SSM_PARAMETER_PATH=/daily-report-app/dev
